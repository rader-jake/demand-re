NODE_ENV=development
PORT=5003

# Database
DATABASE_URL=https://demand-re-production.up.railway.app/

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# AWS (optional, for S3 document storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# CORS
ALLOWED_ORIGINS=https://demand-re.com,https://www.demand-re.com,https://demand-re.vercel.app,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Meta Lead Ads Integration
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_WEBHOOK_VERIFY_TOKEN=your_meta_webhook_verify_token_here

# Resend Email Service Configuration
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Demand RE <insights@demand-re.com>
FRONTEND_URL=https://demand-re.com
